import random
from art import hammer

items_to_auction = {
    "TV": random.randint(100, 150),
    "Guitar": random.randint(200,250),
    "Vintage vase": random.randint(250, 1000),
}



def auction():
    result = {}

    for item, price in items_to_auction.items():
        print(hammer)
        print(f"Item to auction is {item}")
        print(f"Starting price: {price}")

        bid_dic = {}
        on = True

        while on:
            name = input("What is your name?\n").strip()
            bid = int(input("What is your bid?\n"))

            # keep highest bid of same person for this item
            if name in bid_dic:
                if bid > bid_dic[name]:
                    bid_dic[name] = bid
            else:
                bid_dic[name] = bid

            question = input("Is there another bid? (yes/no)\n").lower()

            if question == "no":
                highest_bidder = max(bid_dic, key=bid_dic.get)
                highest_bid = bid_dic[highest_bidder]

                result[item] = {
                    "winner": highest_bidder,
                    "bid": highest_bid,
                    "price": price,
                    "profit": highest_bid - price
                }
                on = False
            else:
                print("\n" * 20)

    return result


