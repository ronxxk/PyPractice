number1 = float(input("enter the 1st number \n"))
number2 = float(input("enter the 2nd number \n"))

selct = input("select the operation\n Press 1 for(+) \n Press 2 for(-) \n Press 3 for(x) \n Press 4 for(/) \n")
if selct in ["1"]:
    print(number1 + number2)
if selct in ["2"]:
    print(number1 - number2)    
if selct in ["3"]:
    print(number1 * number2)    
if selct in ["4"]:
    print(number1 / number2)    



