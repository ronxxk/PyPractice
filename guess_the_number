    return difficult

def guess(difficult):
    if difficult == "e":
        return 12
    elif difficult == "m":
        return 8
    elif difficult == "h":
        return 5
    
def number():
    num = random.randint(0, 100)
    return num

def game(nom, no_guesss):
    print("Welcome to the Number Guessing Game!\n")
    print("I'm thinking of a number between 1 and 100\n")
    #print(nom)
    game = True
    no_guess = int(no_guesss)

    while game:
        print(f"You have {no_guess} left!")
        
        if no_guess == 0:
            print("You lost!\n")
            print(f"The number was {nom}!")
            game = False
        else:
            make_guess = int(input("Make a guess\n"))


        if no_guess != 0:
            if make_guess > nom and no_guess != 0:
                print("Too high")
            elif make_guess < nom and no_guess != 0:
                print("Too low")
            elif make_guess == nom:
                print("you win!\n")
                print(f"The number was {nom}!")

                game = False
            no_guess -= 1

            
game(number(), guess(difficulty()))