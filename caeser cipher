def cipher(original_text, shift_amount, encode_or_decode):
    shift_text = ""

    for letter in original_text:
        if letter not in alphabet:
            shift_text += letter
        else:
            if encode_or_decode == "encode":
                x =  operator.add
            elif encode_or_decode == "decode":
                x = operator.sub
            else:
                print("You choose the invalid option try again")
                exit()
            indices = x(alphabet.index(letter), shift_amount)
            indices = indices % len(alphabet)
            shift_text += alphabet[indices]

    print(f"Your {direction}d message is: {shift_text}")

Run = True

while Run:
    
    direction = input("Type 'encode' to encrypt, type 'decode' to decrypt:\n").lower()
    text = input("Type your message:\n").lower()
    shift = int(input("Type the shift number:\n"))
    cipher(original_text=text, shift_amount=shift, encode_or_decode=direction)


    ans = input("Do you wanna have another go? type yes or no \n").lower()
    if ans == "no":
        Run = False
